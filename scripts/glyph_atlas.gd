extends RefCounted

# A tiny built-in 5x7 bitmap font. No textures, sprites or external imagery.
const CHARS := [" ", ".", ":", "-", "/", "\\", "|", "+", "i", "l", "v", "Y", "o", "x", "*", "%", "#", "@", "~", "="]
const ROWS := {
" ": ["00000","00000","00000","00000","00000","00000","00000"],
".": ["00000","00000","00000","00000","00000","00100","00000"],
":": ["00000","00100","00000","00000","00100","00000","00000"],
"-": ["00000","00000","00000","11111","00000","00000","00000"],
"/": ["00001","00010","00010","00100","01000","01000","10000"],
"\\": ["10000","01000","01000","00100","00010","00010","00001"],
"|": ["00100","00100","00100","00100","00100","00100","00100"],
"+": ["00000","00100","00100","11111","00100","00100","00000"],
"i": ["00100","00000","01100","00100","00100","01110","00000"],
"l": ["01100","00100","00100","00100","00100","01110","00000"],
"v": ["00000","00000","10001","10001","01010","00100","00000"],
"Y": ["10001","10001","01010","00100","00100","00100","00000"],
"o": ["00000","00000","01110","10001","10001","01110","00000"],
"x": ["00000","00000","10001","01010","00100","01010","10001"],
"*": ["00000","10101","01110","11111","01110","10101","00000"],
"%": ["11001","11010","00100","00100","01011","10011","00000"],
"#": ["01010","11111","01010","11111","01010","00000","00000"],
"@": ["01110","10001","10111","10101","10111","10000","01110"],
"~": ["00000","00000","01001","10101","10010","00000","00000"],
"=": ["00000","00000","11111","00000","11111","00000","00000"]
}

func make_texture() -> Texture2D:
    var img := Image.create(96, 16, false, Image.FORMAT_RGBA8)
    img.fill(Color.BLACK)
    for n in range(CHARS.size()):
        var glyph: String = CHARS[n]
        var rows: Array = ROWS[glyph]
        var x0: int = (n % 16) * 6
        var y0: int = (n / 16) * 8
        for y in range(7):
            var bits: String = rows[y]
            for x in range(5):
                if bits.substr(x, 1) == "1":
                    img.set_pixel(x0 + x, y0 + y, Color.WHITE)
    return ImageTexture.create_from_image(img)
